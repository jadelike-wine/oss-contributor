{
  "repositories": [
    "QwenLM/qwen-code",
    "google-gemini/gemini-cli",
    "anomalyco/opencode",
    "cline/cline",
    "OpenHands/OpenHands",
    "Kilo-Org/kilocode",
    "aaif-goose/goose",
    "SWE-agent/mini-swe-agent",
    "567-labs/instructor",
    "Aider-AI/aider",
    "NousResearch/hermes-agent",
    "OpenBMB/ChatDev",
    "ag2ai/ag2",
    "agno-agi/agno",
    "browser-use/browser-use",
    "cloudwego/eino",
    "crewAIInc/crewAI",
    "e2b-dev/code-interpreter",
    "huggingface/smolagents",
    "julep-ai/julep",
    "langchain-ai/deepagents",
    "langchain-ai/langgraph",
    "langflow-ai/langflow",
    "mcp-use/mcp-use",
    "microsoft/semantic-kernel",
    "microsoft/vscode",
    "mistralai/mistral-vibe",
    "modelcontextprotocol/python-sdk",
    "openai/codex",
    "openinterpreter/openinterpreter",
    "pydantic/pydantic-ai",
    "run-llama/llama_index",
    "stanfordnlp/dspy"
  ],
  "repository_checks": {
    "max_inactive_days": 180,
    "retired": {
      "continuedev/continue": {
        "reason": "Official README: no longer actively maintained; read-only for all users",
        "evidence": "https://github.com/continuedev/continue#readme"
      },
      "SWE-agent/SWE-agent": {
        "reason": "Official README: development moved to mini-swe-agent, which supersedes SWE-agent",
        "evidence": "https://github.com/SWE-agent/SWE-agent#readme"
      }
    },
    "policies": {
      "aaif-goose/goose": {
        "ready_project": "https://github.com/orgs/aaif-goose/projects/1",
        "manual_issue_submission": true,
        "human_pr_review_required": true,
        "evidence": "https://github.com/aaif-goose/goose/blob/main/CONTRIBUTING.md"
      }
    }
  },
  "model": "tokenking/devin/swe-2",
  "timeout_seconds": 1500,
  "scan_limit": 100,
  "max_analysis_per_tick": 1,
  "opencode_executable": "opencode",
  "automation": {
    "enabled": true,
    "max_tasks_per_tick": 1,
    "max_stage_attempts": 3,
    "weekly_hunts": true
  },
  "review_model": "tokenking/devin/swe-2",
  "repository_catalog": "repository-catalog.json",
  "research": {
    "model_channel": "hermes",
    "candidates_per_run": 3,
    "peers_per_candidate": 3,
    "files_per_peer": 4,
    "target_files": 12,
    "file_characters": 12000,
    "context_characters": 320000,
    "network_requests": 40,
    "catalog_max_age_days": 30,
    "batch_on_auto": true
  },
  "timeouts": {
    "command_seconds": 180,
    "model_seconds": 1500,
    "test_seconds": 1500,
    "git_seconds": 600,
    "stage_seconds": 2400,
    "remote_ci_seconds": 1800
  },
  "budgets": {
    "run_model_calls": 16,
    "task_model_calls": 40,
    "daily_model_calls": null,
    "run_seconds": 5400,
    "task_seconds": 3600,
    "daily_seconds": 21600,
    "run_cost_usd": null,
    "daily_cost_usd": null
  }
}
